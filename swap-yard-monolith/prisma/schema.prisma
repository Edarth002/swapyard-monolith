datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(cuid())
  firstname     String?
  lastname      String?
  username      String?         @unique
  email         String          @unique
  password      String?
  state         String?
  address       String?
  role          Role            @default(BUYER)
  phoneNumber   String?
  emailVerified DateTime?
  image         String?
  contract      Boolean         @default(false)
  bio           String?
  deliveryAddress String?
  dateOfBirth     DateTime?
  verification      SellerVerification?

  listings           Listing[]
  receivedReviews    Review[]        @relation("SellerReviews")
  givenReviews       Review[]        @relation("BuyerReviews")

  cart               Cart?           @relation("BuyerCart")
  buyerOrders        Order[]         @relation("BuyerOrders")
  payments           Payment[]       @relation("BuyerPayments")

  sellerAccount      SellerAccount?
  sellerOrderItems   OrderItem[]     @relation("SellerOrderItems")
  payouts            Payout[]        @relation("SellerPayouts")

  reports            Report[]        @relation("Reporter")

  notifications      Notification[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Listing {
  id             String            @id @default(cuid())
  name           String            @db.VarChar(191)
  slug           String            @unique
  price          Decimal           @db.Decimal(12, 2)
  images         Image[]
  description    String           @db.Text
  location       String?
  state          String?
  status         ProductStatus     @default(AVAILABLE)
  condition      ProductCondition
  negotiable     Boolean           @default(false)
  offersDelivery Boolean           @default(false)
  contact        String?

  categoryId     String?
  category       Category?          @relation(fields: [categoryId], references: [id])

  sellerId       String
  seller         User              @relation(fields: [sellerId], references: [id])

  reports        Report[]

  cartItems      CartItem[]
  orderItems     OrderItem[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  SlugHistory    ListingSlugHistory[] 

  @@index([sellerId])
  @@index([categoryId, status, createdAt])
  @@index([status, createdAt])
}

model ListingSlugHistory {
  id        String   @id @default(cuid())
  slug      String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([slug])
  @@index([listingId])
}

model Image {
  id        String  @id @default(cuid())
  url       String  @db.VarChar(500)
  publicId  String? @db.VarChar(191)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

enum ProductStatus {
  SOLD
  AVAILABLE
  REMOVED
}

enum ProductCondition {
  NEW
  FAIRLYNEW
  SECONDHAND
  FAIR
  GOOD
}

model Review {
  id       String @id @default(cuid())

  rating   Int     @db.TinyInt
  comment  String? @db.Text
  buyerId  String
  buyer    User @relation("BuyerReviews", fields: [buyerId], references: [id])

  sellerId String
  seller   User @relation("SellerReviews", fields: [sellerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([buyerId, sellerId])

  @@index([sellerId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  image     String?   @db.VarChar(500)
  publicId  String?   @db.VarChar(191)
  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  CategorySlugHistory CategorySlugHistory[]

  @@index([name])
}

model CategorySlugHistory {
  id         String   @id @default(cuid())
  slug       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([slug])
  @@index([categoryId])
}

model Cart {
  id        String     @id @default(cuid())
  buyerId   String     @unique
  buyer     User       @relation("BuyerCart", fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  quantity  Int      @default(1)

  createdAt DateTime @default(now())

  @@unique([cartId, listingId])
  @@index([listingId])
}

model SellerAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description    String?  @db.Text
  accountName    String   @default("") @db.VarChar(191)
  accountNumber  String   @default("") @db.VarChar(20)
  bankName       String   @default("") @db.VarChar(100)
  bankCode       String?  @db.VarChar(10)
  accountType    String   @db.VarChar(50)
  isVerified     Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

}

model Order {
  id                  String        @id @default(cuid())

  buyerId             String
  buyer               User          @relation("BuyerOrders", fields: [buyerId], references: [id])

  status              OrderStatus   @default(PENDING_PAYMENT)

  subtotal            Decimal @default(0.00)  @db.Decimal(12,2)
  deliveryFee         Decimal @default(0.00)  @db.Decimal(12,2)
  platformCommission  Decimal @default(0.00)  @db.Decimal(12,2)
  totalAmount         Decimal @default(0.00)  @db.Decimal(12,2)

  payment             Payment?
  items               OrderItem[]
  payouts             Payout[]
  
  pickupLocation      String?
  pickupNote          String?  @db.Text

  sellerNotifiedAt    DateTime?
  buyerConfirmedAt    DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([buyerId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())

  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id])

  sellerId      String
  seller        User     @relation("SellerOrderItems", fields: [sellerId], references: [id])

  listingName   String   @default("")      @db.VarChar(191)
  unitPrice     Decimal  @default(0.00)  @db.Decimal(12,2)
  quantity      Int      @default(1)      

  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([listingId])
  @@index([sellerId])
}

model Payment {
  id            String          @id @default(cuid())

  orderId       String          @unique
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  buyerId       String
  buyer         User            @relation("BuyerPayments", fields: [buyerId], references: [id])

  amount        Decimal          @default(0.00)  @db.Decimal(12,2)
  currency      String          @default("NGN") @db.VarChar(10)
  provider      PaymentProvider @default(PAYSTACK)
  providerRef   String?         @unique
  status        PaymentStatus   @default(PENDING)

  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt


  @@index([buyerId, status])
}

model Payout {
  id                String        @id @default(cuid())

  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sellerId          String
  seller            User          @relation("SellerPayouts", fields: [sellerId], references: [id])

  grossAmount       Decimal         @default(0.00)  @db.Decimal(12,2)
  commissionAmount  Decimal         @default(0.00)  @db.Decimal(12,2)
  netAmount         Decimal         @default(0.00)  @db.Decimal(12,2)

  status            PayoutStatus  @default(PENDING)
  providerRef       String?       @unique
  processedAt       DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([sellerId, status])
}

model SellerVerification {
  id                       String               @id @default(cuid())
  userId                   String               @unique
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName                 String?
  businessName             String?
  vatNumber                String?              @db.VarChar(50)
  nin                      String?              @db.VarChar(20)

  businessLicenseUrl       String?              @db.VarChar(500)
  businessLicensePublicId  String?              @db.VarChar(191)

  idDocumentUrl            String?              @db.VarChar(500)
  idDocumentPublicId       String?              @db.VarChar(191)

  status                   VerificationStatus   @default(NOT_SUBMITTED)
  reviewNote               String?              @db.Text
  submittedAt              DateTime?
  reviewedAt               DateTime?

  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

    @@index([status])
  @@index([businessName])
  @@index([nin])
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  BUYER_CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REVERSED
  ON_HOLD
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
  MANUAL
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  status    String   @default("PENDING") @db.VarChar(30)
  response  Json? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idempotencyKey")
}

model Report {
  id          String   @id @default(cuid())
  idempotencyKey String   @unique
  reporterId  String
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id])
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  type        String   @db.VarChar(50)
  reason      String   @db.Text
  comment     String?  @db.Text
  imageUrl1  String?   @db.VarChar(500)
  imagePublicId1 String? @db.VarChar(191)
  imageUrl2  String?     @db.VarChar(500)
  imagePublicId2 String? @db.VarChar(191)
  status      ReportStatus @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reporterId])
  @@index([listingId])
  @@index([status])
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @db.VarChar(50)
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read])
}